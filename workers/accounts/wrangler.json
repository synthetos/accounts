{
  "name": "accounts",
  "main": "workers/accounts/src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "accounts.synthetos.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
