    }
  ],
  "vars": {
    "AUTH_ENABLED": "true",
    "ACCOUNT_ORIGIN": "https://accounts.synthetos.com",
    "GITHUB_APP_ID": "5562809",
    "GITHUB_CLIENT_ID": "Iv23liIlkNxE7f3oEyX4",
    "GITHUB_ALLOWED_IDS": "[\"231731\"]"
  },
  "env": {
    "staging": {
      "name": "accounts-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": false
      },
      "routes": [
        {
          "pattern": "staging.accounts.synthetos.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "IDENTITY",
          "database_name": "identity-staging",
          "database_id": "3b93d493-bca2-4377-a4bc-3568822bd531",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "AUTH_ENABLED": "true",
        "ACCOUNT_ORIGIN": "https://staging.accounts.synthetos.com",
        "GITHUB_APP_ID": "5562809",
        "GITHUB_CLIENT_ID": "Iv23liIlkNxE7f3oEyX4",
        "GITHUB_ALLOWED_IDS": "[\"231731\"]"
      }
    }
  },
  "observability": {
    "enabled": false
  },
  "find_additional_modules": true,
  "base_dir": ".",
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js"
      ],
      "fallthrough": true
    }
  ]
}
